# Optional personalized AI. Set through hosted runtime secrets; never expose to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional authenticated HTTPS notification gateway. It maps recipient IDs to opted-in channels.
NOTIFICATION_GATEWAY_URL=
NOTIFICATION_GATEWAY_TOKEN=
# External schedule calls /api/reminders/process once a minute when these services are configured.
REMINDER_JOB_SECRET=
# Managed DB and BUCKET bindings come from .openai/hosting.json, not client environment variables.
# No live payments are enabled by this example configuration.

# Optional coturn-compatible relay. Comma-separated turn:/turns: URLs and its shared secret.
TURN_URLS=
TURN_SHARED_SECRET=

# Shop checkout stays disabled until the merchant account and signed webhook are connected.
SHOP_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe webhook: /api/shop/webhook. Enable checkout.session.completed,
# checkout.session.expired, customer.subscription.*, charge.refunded, charge.dispute.created.
# Enable subscription cancellation in the Stripe customer portal before launch.

# Physical gifts: enable only after provider eligibility, tax setup, seller agreements,
# and fulfillment operations are confirmed for each explicitly supported market.
MARKETPLACE_ENABLED=false
MARKETPLACE_COUNTRIES=
# Final commission in basis points, e.g. 1000 = 10%; required, no hidden default.
MARKETPLACE_FEE_BPS=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Connected-account events -> /api/marketplace/webhook:
# checkout.session.completed, checkout.session.expired, checkout.session.async_payment_*,
# account.updated, charge.refunded, charge.dispute.created, charge.dispute.closed.
# Seller direct charges, full Stripe dashboard, automatic tax. Seller Stripe Tax setup
# and registrations must be configured before checkout; India requires provider approval.
