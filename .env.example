# Required for sign-in, sessions, and saved data on Vercel / Node.
# Neon pooled example:
# DATABASE_URL=postgres://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Vercel Marketplace Postgres also injects DATABASE_URL or POSTGRES_URL.
DATABASE_URL=
POSTGRES_URL=

# Required in production. Random 32+ character secret used to hash session tokens.
# Generate with: openssl rand -base64 48
AUTH_SECRET=
SESSION_SECRET=

# Public site URL used in invitation links, password-reset emails, sitemap, and Open Graph.
# Example: https://lovelinklos.vercel.app
APP_URL=

# Optional. Required together to send password-reset emails via Resend.
# Without these, /api/auth/forgot still succeeds (no email enumeration) but no email is sent.
RESEND_API_KEY=
EMAIL_FROM=

# Photo and media uploads are stored in Postgres (media_blobs). No Cloudflare R2 or
# Vercel Blob token is required.

# Optional personalized AI. Never expose to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional authenticated HTTPS notification gateway. It maps recipient IDs to opted-in channels.
NOTIFICATION_GATEWAY_URL=
NOTIFICATION_GATEWAY_TOKEN=
# External schedule calls /api/reminders/process once a minute when these services are configured.
REMINDER_JOB_SECRET=

# Optional Web Push (VAPID). If any of these are unset, LoveLink skips sending pushes.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Protects the hourly /api/cron/reminders job. Required for that route to run.
CRON_SECRET=

# Operations dashboard at /dashboard (and GET /api/dashboard). Not public.
# Production/preview: require DASHBOARD_SECRET, DASHBOARD_ADMIN_EMAILS, or the
# signed-in site owner (CONCIERGE_OWNER / optional DASHBOARD_OWNER_ID).
# Local development: any signed-in account is enough if no secret is set.
# Generate a password with: openssl rand -base64 24
DASHBOARD_SECRET=
DASHBOARD_ADMIN_EMAILS=
# Optional. Defaults to the LoveLink site-owner id in lib/concierge-operator.ts.
DASHBOARD_OWNER_ID=

# Optional coturn-compatible relay. Comma-separated turn:/turns: URLs and its shared secret.
TURN_URLS=
TURN_SHARED_SECRET=

# Shop checkout stays disabled until the merchant account and signed webhook are connected.
SHOP_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe webhook: /api/shop/webhook. Enable checkout.session.completed,
# checkout.session.expired, customer.subscription.*, charge.refunded, charge.dispute.created.
# Enable subscription cancellation in the Stripe customer portal before launch.
# LoveLink Plus and gift installment plans work in demo mode without these keys
# (no real charge). When SHOP_ENABLED=true and both Stripe secrets are set,
# /api/billing and /api/payment-plans open Stripe Checkout instead.
# Do not invent or commit live secrets.

# Physical gifts: enable only after provider eligibility, tax setup, seller agreements,
# and fulfillment operations are confirmed for each explicitly supported market.
MARKETPLACE_ENABLED=false
MARKETPLACE_COUNTRIES=
# Final commission in basis points, e.g. 1000 = 10%; required, no hidden default.
MARKETPLACE_FEE_BPS=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Connected-account events -> /api/marketplace/webhook:
# checkout.session.completed, checkout.session.expired, checkout.session.async_payment_*,
# account.updated, charge.refunded, charge.dispute.created, charge.dispute.closed.
# Seller direct charges, full Stripe dashboard, automatic tax. Seller Stripe Tax setup
# and registrations must be configured before checkout; India requires provider approval.
